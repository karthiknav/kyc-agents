            "upgrade_install": null,
            "values": [
              "global:\r\n  defaultStorageClass: efs\r\nlangfuse:\r\n  salt:\r\n    secretKeyRef:\r\n      name: langfuse\r\n      key: salt\r\n  nextauth:\r\n    url: \"https://langfuse.noonehasthisdomain.click\"\r\n    secret:\r\n      secretKeyRef:\r\n        name: langfuse\r\n        key: nextauth-secret\r\n  serviceAccount:\r\n    annotations:\r\n      eks.amazonaws.com/role-arn: arn:aws:iam::206409480438:role/kubernetes/langfuse\r\n  # Resource configuration for production workloads\r\n  resources:\r\n    limits:\r\n      cpu: \"2\"\r\n      memory: \"4Gi\"\r\n    requests:\r\n      cpu: \"2\"\r\n      memory: \"4Gi\"\r\n  # The Web container needs slightly increased initial grace period on Fargate\r\n  web:\r\n    replicas: 0\r\n    livenessProbe:\r\n      initialDelaySeconds: 60\r\n    readinessProbe:\r\n      initialDelaySeconds: 60\r\n  worker:\r\n    replicas: 1\r\npostgresql:\r\n  deploy: false\r\n  host: langfuse-postgres.cluster-ceviyi5z4s3h.us-east-1.rds.amazonaws.com:5432\r\n  auth:\r\n    username: langfuse\r\n    database: langfuse\r\n    existingSecret: langfuse\r\n    secretKeys:\r\n      userPasswordKey: postgres-password\r\nclickhouse:\r\n  auth:\r\n    existingSecret: langfuse\r\n    existingSecretKey: clickhouse-password\r\n  replicaCount: 3\r\n  # Resource configuration for ClickHouse containers\r\n  resources:\r\n    limits:\r\n      cpu: \"2\"\r\n      memory: \"8Gi\"\r\n    requests:\r\n      cpu: \"2\"\r\n      memory: \"8Gi\"\r\n  # Resource configuration for ClickHouse Keeper\r\n  zookeeper:\r\n    replicaCount: 3\r\n    resources:\r\n      limits:\r\n        cpu: \"1\"\r\n        memory: \"2Gi\"\r\n      requests:\r\n        cpu: \"1\"\r\n        memory: \"2Gi\"\r\nredis:\r\n  deploy: false\r\n  host: master.langfuse.of83ee.use1.cache.amazonaws.com\r\n  auth:\r\n    existingSecret: langfuse\r\n    existingSecretPasswordKey: redis-password\r\n  tls:\r\n    enabled: true\r\ns3:\r\n  deploy: false\r\n  bucket: langfuse-noonehasthisdomain-click-langfuse\r\n  region: us-east-1\r\n  forcePathStyle: false\r\n  eventUpload:\r\n    prefix: \"events/\"\r\n  batchExport:\r\n    prefix: \"exports/\"\r\n  mediaUpload:\r\n    prefix: \"media/\"\r\n",
              "langfuse:\r\n  ingress:\r\n    enabled: true\r\n    className: alb\r\n    annotations:\r\n      alb.ingress.kubernetes.io/listen-ports: '[{\"HTTP\":80}, {\"HTTPS\":443}]'\r\n      alb.ingress.kubernetes.io/scheme: internet-facing\r\n      alb.ingress.kubernetes.io/target-type: 'ip'\r\n      alb.ingress.kubernetes.io/ssl-redirect: '443'\r\n      alb.ingress.kubernetes.io/inbound-cidrs: 0.0.0.0/0\r\n    hosts:\r\n    - host: langfuse.noonehasthisdomain.click\r\n      paths:\r\n      - path: /\r\n        pathType: Prefix\r\n",
              "langfuse:\r\n  encryptionKey:\r\n    secretKeyRef:\r\n      name: langfuse\r\n      key: encryption_key\r\n",
              "clickhouse:\r\n  extraOverrides: |\r\n      \u003cclickhouse\u003e\r\n        \u003ctrace_log remove=\"1\"/\u003e\r\n        \u003ctext_log remove=\"1\"/\u003e\r\n        \u003copentelemetry_span_log remove=\"1\"/\u003e\r\n        \u003casynchronous_metric_log remove=\"1\"/\u003e\r\n        \u003cmetric_log remove=\"1\"/\u003e\r\n        \u003clatency_log remove=\"1\"/\u003e\r\n      \u003c/clickhouse\u003e\r\n",
              "\"langfuse\":\n  \"web\":\n    \"replicas\": 0\n"
            ],
