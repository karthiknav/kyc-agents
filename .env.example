# Tavily Search API key — get one at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# SerpAPI key — used by search_person tool; get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your-serpapi-api-key

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# BRP Identity Verification API (mock service)
BRP_API_URL=http://localhost:9000/api/v1/brp/personen/document-lookup
MOCK_SERVICE_PORT=9000
